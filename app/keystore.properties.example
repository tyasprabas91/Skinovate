# Signing Configuration Template
# Copy this file to keystore.properties and fill in your actual values
# DO NOT commit keystore.properties to version control!

# Path to your keystore file (relative to app directory or absolute path)
storeFile=../keystore/skinovate-release.jks

# Keystore password
storePassword=your-store-password

# Key alias
keyAlias=skinovate-key

# Key password
keyPassword=your-key-password


